# Copy to .env (gitignored). Every variable used by docker-compose.yml is
# documented here; the compose file uses `${VAR:?message}` for the required ones.
# Nothing in this stack is published outside 127.0.0.1.

# ── Kafka (WP 01) ────────────────────────────────────────────────────────────
# Cluster id for KRaft: generate once with
#   docker run --rm apache/kafka:<pinned-tag> /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=
# JVM heap cap. Without it the JVM takes a fraction of the machine's RAM, which
# is shared with other projects and heavy pricing runs.
KAFKA_HEAP_OPTS=-Xmx512m -Xms512m

# ── Audit database (WP 02) ───────────────────────────────────────────────────
# Three roles, no UPDATE/DELETE for anybody. Generate: openssl rand -hex 24
AUDIT_DB_OWNER_PASSWORD=     # migrations only
AUDIT_DB_WRITER_PASSWORD=    # used by audit-sink only (INSERT)
AUDIT_DB_READER_PASSWORD=    # used by Grafana and the API replay endpoint (SELECT)

# ── Grafana (WP 03) ──────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=

# ── Alerts (WP 04) ───────────────────────────────────────────────────────────
# Notification channel — to be chosen (see blueprint/wp/04-data-quality-alerts.md).
ALERT_WEBHOOK_URL=

# ── Host ports (127.0.0.1 only; debugging) ───────────────────────────────────
QP_GRAFANA_PORT=3100
QP_AKHQ_PORT=8181
QP_KAFKA_PORT=9094           # EXTERNAL listener, for debugging from the host
