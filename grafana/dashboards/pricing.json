{
  "uid": "qm-pricing",
  "title": "Pricing — durations, errors, market-data fallbacks",
  "description": "Histograms per product, engine and model (qm_pricing_duration_seconds), plus the valuations behind them, read from the audit trail.",
  "tags": [
    "quant-platform"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Durations",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "p95 duration by product / engine / model",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, product, engine, model) (rate(qm_pricing_duration_seconds_bucket[5m])))",
          "legendFormat": "{{product}} · {{engine}} · {{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Valuations / s by product",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (product) (rate(qm_pricing_duration_seconds_count[5m]))",
          "legendFormat": "{{product}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Errors and fallbacks",
      "collapsed": false,
      "panels": [],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Pricing errors by product and code",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (product, code) (rate(qm_pricing_errors_total[5m]))",
          "legendFormat": "{{product}} · {{code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Fallbacks (1 h) by kind — must be flat at zero",
      "description": "Every silent fallback of the old code is now an event. The end-of-work measure is: nothing here over a week of normal traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (increase(qm_data_fallback_total[1h]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "From the audit trail (qm-audit)",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Quality of market inputs per day",
      "description": "unobserved = at least one input is default or proxied; stale = a stale input; observed = all inputs observed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qm-audit"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qm-audit"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamptz AS time, status AS metric, valuations FROM audit.v_valuations_by_status WHERE $__timeFilter(day::timestamptz) ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Slowest valuations — click trace_id to open the trace",
      "description": "Audit row → trace: the two paths share trace_id (ADR-004).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qm-audit"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qm-audit"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT occurred_at, product, engine, model, duration_ms, trace_id FROM audit.v_slowest_valuations ORDER BY duration_ms DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the trace in Tempo",
                    "targetBlank": true,
                    "url": "/explore?schemaVersion=1&panes={\"a\":{\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"},\"queryType\":\"traceql\",\"query\":\"${__value.raw}\"}],\"range\":{\"from\":\"now-24h\",\"to\":\"now\"}}}&orgId=1"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      }
    }
  ]
}
