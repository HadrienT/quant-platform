    {
      "type": "table",
      "title": "Failed logins by hashed IP",
      "description": "Many usernames from one hash = credential stuffing; one username from many hashes = targeted guessing.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qm-audit"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qm-audit"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT payload->>'ip_hash' AS ip_hash, count(*) AS failures, count(DISTINCT username) AS usernames_tried, min(occurred_at) AS first_seen, max(occurred_at) AS last_seen FROM audit.events WHERE $__timeFilter(occurred_at) AND type = 'auth.login_failed' GROUP BY 1 ORDER BY failures DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "auth events by outcome (metric path)",
      "description": "The same facts through the OTLP path (qm_auth_events_total); compare with the audit trail (ADR-004).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(qm_auth_events_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
