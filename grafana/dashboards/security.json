    {
      "type": "timeseries",
      "title": "Auth events over time",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qm-audit"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qm-audit"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(occurred_at, '5m'), type AS metric, count(*) AS events FROM audit.events WHERE $__timeFilter(occurred_at) AND type LIKE 'auth.%' GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": {
