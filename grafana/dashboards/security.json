{
  "uid": "qm-security",
  "title": "Security — logins, rate limits, hashed IPs",
  "description": "Read from the audit trail as audit_reader. IPs appear only as HMAC hashes (ADR-009): same IP, same hash, so bursts are visible without the address.",
  "tags": [
    "quant-platform"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
