{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-platform.local/schemas/envelope.json",
  "title": "Event envelope (docs/contract.md §1)",
  "description": "Common to every event. Describes the envelope ONLY: the payload belongs to the producer and is not interpreted here (ADR-007).",
  "type": "object",
  "required": ["event_id", "type", "version", "occurred_at", "request_id", "trace_id", "username", "producer", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "description": "UUID v7. The sink's idempotency key.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "description": "<domain>.<subject>, e.g. pricing.valuation, auth.login_failed, data.fallback",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "version": {
      "description": "Version of the PAYLOAD schema (not of the envelope).",
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "description": "UTC instant set by the producer; drives the monthly partition.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "request_id": { "type": ["string", "null"], "maxLength": 200 },
    "trace_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
    "username": { "description": "null for an anonymous caller.", "type": ["string", "null"], "maxLength": 200 },
    "producer": {
      "type": "object",
      "required": ["service"],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string" },
        "lib_build": { "type": "string" }
      }
    },
    "payload": { "type": "object" }
  }
}
